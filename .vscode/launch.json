    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/Bot/bin/Debug/net10.0/Bot.dll",
            "args": [    
                "--GamePort", "5000",
                "--StartPort", "5001",
                "--LadderServer", "127.0.0.1"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole",
            
        },
        

    ]
}